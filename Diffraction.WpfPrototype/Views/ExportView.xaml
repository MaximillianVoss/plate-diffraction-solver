<UserControl x:Class="Diffraction.WpfPrototype.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Diffraction.WpfPrototype.Controls">
    <Grid x:Name="ExportRoot" MaxWidth="1080" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="2,0,0,12">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Экспорт результатов" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Предварительный просмотр рассчитанных данных; сохранение в файл пока не подключено." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ExportContentGrid" MinHeight="560">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="ExportGapRow" Height="0" />
                <RowDefinition x:Name="ExportPreviewRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ExportOptionsColumn" Width="340" /><ColumnDefinition x:Name="ExportGapColumn" Width="12" /><ColumnDefinition x:Name="ExportPreviewColumn" Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="ExportOptionsPanel" Style="{StaticResource PanelBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Содержимое пакета" />
                    <CheckBox Margin="0,15,0,0" IsChecked="True" IsEnabled="False" Content="CSV — точки графиков и таблиц" />
                    <CheckBox Margin="0,10,0,0" IsChecked="True" IsEnabled="False" Content="PNG — карты поля и графики" />
                    <CheckBox Margin="0,10,0,0" IsChecked="True" IsEnabled="False" Content="SVG — графики для публикации" />
                    <CheckBox Margin="0,10,0,0" IsChecked="True" IsEnabled="False" Content="JSON — параметры и версия решателя" />
                    <CheckBox Margin="0,10,0,0" IsChecked="True" IsEnabled="False" Content="Отчёт — ЗСЭ, потоки и диагностика" />
                    <Separator Margin="0,16" />
                    <TextBlock FontWeight="SemiBold" Text="Имя пакета" />
                    <TextBox Margin="0,7,0,0" IsReadOnly="True" Text="Формируется из параметров расчёта" />
                    <Button Margin="0,18,0,0" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Content="Сохранение пока недоступно" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" x:Name="ExportPreviewPanel" Style="{StaticResource PanelBorderStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Предварительный просмотр" />
                    <controls:ScientificPlot Grid.Row="1" Margin="0,12,0,8" Data="{Binding CurrentEnergyPlot}" />
                    <controls:ScientificPlot Grid.Row="2" Margin="0,0,0,8" Data="{Binding MethodPlot}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource CaptionStyle}" Text="Подписи осей, легенда, краткое описание и снимок параметров включаются автоматически." />
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
