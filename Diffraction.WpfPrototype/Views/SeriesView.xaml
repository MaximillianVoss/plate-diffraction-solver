<UserControl x:Class="Diffraction.WpfPrototype.Views.SeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:Diffraction.WpfPrototype.Infrastructure"
             xmlns:controls="clr-namespace:Diffraction.WpfPrototype.Controls">
    <Grid x:Name="SeriesRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="DesktopSeriesHeader" Margin="2,0,2,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Серийный анализ" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="Независимые серии: компоненты энергии по толщине скин-слоя и по углу падения, с выгрузкой CSV" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding ContextSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContextSummary}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="105" IsEnabled="{Binding CanEditParameters}" Margin="0,0,9,0" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" ToolTip="Вычислительный backend" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0" FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE768;" />
                    <TextBlock Foreground="White" Text="Запустить серию" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding CancelCommand}" Content="Отмена" />
        </Grid>

        <StackPanel Grid.Row="0" x:Name="CompactSeriesHeader" Margin="1,0,1,8" Visibility="Collapsed">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Серийный анализ" />
            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding ContextSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContextSummary}" />
            <WrapPanel Margin="0,8,0,0">
                <ComboBox Width="102" IsEnabled="{Binding CanEditParameters}" Margin="0,0,7,6" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" />
                <Button Margin="0,0,0,6" Style="{StaticResource PrimaryButtonStyle}" Padding="11,7" Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE768;" />
                        <TextBlock Foreground="White" Text="Запустить серию" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,6" Style="{StaticResource DangerButtonStyle}" Padding="11,7"
                        Command="{Binding CancelCommand}" Content="Отмена" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      x:Name="SeriesScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SeriesContentGrid" MinHeight="620">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="SeriesFirstGapRow" Height="0" />
                <RowDefinition x:Name="SeriesChartsRow" Height="0" />
                <RowDefinition x:Name="SeriesSecondGapRow" Height="0" />
                <RowDefinition x:Name="SeriesResultsRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SeriesParametersColumn" Width="250" />
                <ColumnDefinition x:Name="SeriesFirstGapColumn" Width="10" />
                <ColumnDefinition x:Name="SeriesChartsColumn" Width="*" />
                <ColumnDefinition x:Name="SeriesSecondGapColumn" Width="10" />
                <ColumnDefinition x:Name="SeriesResultsColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="SeriesParametersPanel" IsEnabled="{Binding CanEditParameters}" Style="{StaticResource PanelBorderStyle}" Padding="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Постоянные параметры" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Длина волны λ" />
                        <TextBox Grid.Column="1" Text="{Binding Parameters.WavelengthMicrometers, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Угол θ, °" />
                        <TextBox Grid.Column="1" Text="{Binding Parameters.IncidenceAngleDegrees, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Параметр N" />
                        <TextBox Grid.Column="1" Text="{Binding Parameters.HarmonicCount, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                    </Grid>

                    <Expander Grid.Row="4" Margin="0,10,0,0" Header="{Binding GeometryRegionSummary}" ToolTip="Геометрия пластины и границы области вывода">
                        <UniformGrid Columns="2" Margin="0,7,0,3">
                            <StackPanel Margin="0,0,4,6"><TextBlock Style="{StaticResource CaptionStyle}" Text="α₁" /><TextBox Text="{Binding Parameters.PlateStart, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" /></StackPanel>
                            <StackPanel Margin="4,0,0,6"><TextBlock Style="{StaticResource CaptionStyle}" Text="β₁" /><TextBox Text="{Binding Parameters.PlateEnd, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" /></StackPanel>
                            <StackPanel Margin="0,0,4,6"><TextBlock Style="{StaticResource CaptionStyle}" Text="xL" /><TextBox Text="{Binding Parameters.OutputLeft, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" /></StackPanel>
                            <StackPanel Margin="4,0,0,6"><TextBlock Style="{StaticResource CaptionStyle}" Text="xR" /><TextBox Text="{Binding Parameters.OutputRight, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" /></StackPanel>
                            <StackPanel Margin="0,0,4,0"><TextBlock Style="{StaticResource CaptionStyle}" Text="yDn" /><TextBox Text="{Binding Parameters.OutputBottom, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" /></StackPanel>
                            <StackPanel Margin="4,0,0,0"><TextBlock Style="{StaticResource CaptionStyle}" Text="yUp" /><TextBox Text="{Binding Parameters.OutputTop, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" /></StackPanel>
                        </UniformGrid>
                    </Expander>

                    <Grid Grid.Row="5" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Диапазон толщины δ" />
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" Content="серия δ"
                                  IsChecked="{Binding Parameters.SeriesSkinDepthEnabled, Mode=TwoWay}"
                                  ToolTip="Включить или отключить серию по толщине скин-слоя" />
                    </Grid>
                    <Grid Grid.Row="6" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Начало" />
                        <TextBox Grid.Column="1" Text="{Binding Parameters.SeriesSkinDepthStart, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                        <TextBlock Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center" Text="Конец" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Parameters.SeriesSkinDepthEnd, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                        <TextBlock Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Center" Text="Точек" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Parameters.SeriesPointCount, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                        <Slider Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" Minimum="2" Maximum="101" Value="{Binding Parameters.SeriesPointCount, Mode=TwoWay, NotifyOnSourceUpdated=True}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </Grid>

                    <Grid Grid.Row="7" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Диапазон угла θ" />
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" Content="серия θ"
                                  IsChecked="{Binding Parameters.SeriesAngleEnabled, Mode=TwoWay}"
                                  ToolTip="Включить или отключить серию по углу падения" />
                    </Grid>
                    <Grid Grid.Row="8" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Начало, °" />
                        <TextBox Grid.Column="1" Text="{Binding Parameters.SeriesAngleStartDegrees, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                        <TextBlock Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center" Text="Конец, °" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Parameters.SeriesAngleEndDegrees, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                        <TextBlock Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Center" Text="Шаг, °" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Parameters.SeriesAngleStepDegrees, Mode=TwoWay, Converter={infrastructure:NumericInputConverter}, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G}, ValidatesOnExceptions=True, NotifyOnValidationError=True, NotifyOnSourceUpdated=True}" />
                    </Grid>

                    <controls:PlateGeometryView Grid.Row="9" Margin="0,12,0,5" MinHeight="150" />
                    <StackPanel Grid.Row="10">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Толщина на схеме отображается условно." />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="{Binding SeriesEstimateText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2" x:Name="SeriesChartsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.45*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="10">
                    <TabControl>
                        <TabItem Header="Исследование: толщина δ">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:ScientificPlot Data="{Binding SkinEnergyPlot}" />
                                <TextBlock Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Каждая точка рассчитана заново для указанной толщины δ; R_scat, T_scat и A_J вычисляются независимо." TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Margin="0,8,0,4" FontWeight="SemiBold" Text="{Binding SkinDepthStudyCaption}" />
                                <DataGrid Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinColumnWidth="130"
                                          ItemsSource="{Binding SkinDepthStudyRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="δ, мкм" Binding="{Binding ArgumentDisplay}" Width="*" />
                                        <DataGridTextColumn Header="R_scat / I_plate, %" Binding="{Binding ReflectedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="T_scat / I_plate, %" Binding="{Binding TransmittedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="A_J / I_plate, %" Binding="{Binding AbsorbedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Σ / I_plate, %" Binding="{Binding SumDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Ext / I_plate, %" Binding="{Binding ExtinctionDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Невязка / Ext, %" Binding="{Binding ImbalanceDisplay}" Width="*" />
                                        <DataGridTextColumn Header="L|sinθ|, мкм" Binding="{Binding CrossSectionScaleDisplay}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExportSkinDepthStudyCommand}" Content="Экспорт CSV — серия по δ" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Исследование: угол θ">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:ScientificPlot Data="{Binding AngleEnergyPlot}" />
                                <TextBlock Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding SeriesAngleCaption}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Margin="0,8,0,4" FontWeight="SemiBold" Text="{Binding AngleStudyIdealCaption}" />
                                <DataGrid Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinColumnWidth="130"
                                          ItemsSource="{Binding AngleStudyIdealRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Угол θ, °" Binding="{Binding ArgumentDisplay}" Width="*" />
                                        <DataGridTextColumn Header="R_scat / I_plate, %" Binding="{Binding ReflectedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="T_scat / I_plate, %" Binding="{Binding TransmittedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="A_J / I_plate, %" Binding="{Binding AbsorbedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Σ / I_plate, %" Binding="{Binding SumDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Ext / I_plate, %" Binding="{Binding ExtinctionDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Невязка / Ext, %" Binding="{Binding ImbalanceDisplay}" Width="*" />
                                        <DataGridTextColumn Header="L|sinθ|, мкм" Binding="{Binding CrossSectionScaleDisplay}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="4" Margin="0,10,0,4" FontWeight="SemiBold" Text="{Binding AngleStudySkinCaption}" />
                                <DataGrid Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinColumnWidth="130"
                                          ItemsSource="{Binding AngleStudySkinRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Угол θ, °" Binding="{Binding ArgumentDisplay}" Width="*" />
                                        <DataGridTextColumn Header="R_scat / I_plate, %" Binding="{Binding ReflectedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="T_scat / I_plate, %" Binding="{Binding TransmittedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="A_J / I_plate, %" Binding="{Binding AbsorbedDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Σ / I_plate, %" Binding="{Binding SumDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Ext / I_plate, %" Binding="{Binding ExtinctionDisplay}" Width="*" />
                                        <DataGridTextColumn Header="Невязка / Ext, %" Binding="{Binding ImbalanceDisplay}" Width="*" />
                                        <DataGridTextColumn Header="L|sinθ|, мкм" Binding="{Binding CrossSectionScaleDisplay}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="6" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExportAngleStudyCommand}" Content="Экспорт CSV — серия по θ" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Оптическая теорема и симметрия рассеяния" TextWrapping="Wrap" />
                        <controls:ScientificPlot Grid.Row="1" Margin="0,7,0,5" Data="{Binding SeriesDiagnosticsPlot}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="{Binding SeriesDiagnosticsCaption}" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="4" x:Name="SeriesResultsPanel" Style="{StaticResource PanelBorderStyle}" Padding="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="{Binding SeriesPointTitle}" />
                    <Separator Grid.Row="1" Margin="0,8" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="C_back, мкм" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Energy.ReflectedDisplay}" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="C_forward, мкм" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Energy.ForwardDisplay}" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="C_abs, мкм" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Energy.AbsorbedDisplay}" />
                    </Grid>
                    <Grid Grid.Row="5" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Оптическая теорема" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{Binding Energy.BalanceForeground}" Text="{Binding Energy.OpticalBalanceErrorDisplay}" ToolTip="{Binding Energy.LocalBalanceResidualDisplay}" />
                    </Grid>
                    <Grid Grid.Row="6" Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" FontWeight="SemiBold" Text="Потоки сверху/снизу" />
                        <TextBlock Grid.Row="1" Margin="0,7,0,0" Text="Сверху / снизу" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{Binding Energy.SheetPairDisplay}" />
                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="Разность" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="{Binding Energy.SheetMismatchDisplay}" />
                    </Grid>

                    <DataGrid Grid.Row="7" Margin="0,14,0,8" AutoGenerateColumns="False" MinHeight="135" ItemsSource="{Binding SeriesCheckSummaries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Контроль серии" Binding="{Binding}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="8">
                        <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                Command="{Binding ExportSkinDepthStudyCommand}" Content="Экспорт CSV — серия по δ" />
                        <Button Margin="0,6,0,0" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                Command="{Binding ExportAngleStudyCommand}" Content="Экспорт CSV — серия по θ" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
