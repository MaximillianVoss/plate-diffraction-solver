<UserControl x:Class="Diffraction.WpfPrototype.Views.SeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Diffraction.WpfPrototype.Controls">
    <Grid x:Name="SeriesRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="DesktopSeriesHeader" Margin="2,0,2,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Серийный анализ" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="R_scat, T_scat, A_J и ЗСЭ по толщине скин-слоя и углу падения" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="105" Margin="0,0,9,0" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" ToolTip="Вычислительный backend" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0" FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE768;" />
                    <TextBlock Foreground="White" Text="Запустить серию" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="0" x:Name="CompactSeriesHeader" Margin="1,0,1,8" Visibility="Collapsed">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Серийный анализ" />
            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="R_scat, T_scat, A_J и ЗСЭ по δ и θ" />
            <WrapPanel Margin="0,8,0,0">
                <ComboBox Width="102" Margin="0,0,7,6" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" />
                <Button Margin="0,0,0,6" Style="{StaticResource PrimaryButtonStyle}" Padding="11,7" Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE768;" />
                        <TextBlock Foreground="White" Text="Запустить серию" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      x:Name="SeriesScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SeriesContentGrid" MinHeight="620">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="SeriesFirstGapRow" Height="0" />
                <RowDefinition x:Name="SeriesChartsRow" Height="0" />
                <RowDefinition x:Name="SeriesSecondGapRow" Height="0" />
                <RowDefinition x:Name="SeriesResultsRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SeriesParametersColumn" Width="250" />
                <ColumnDefinition x:Name="SeriesFirstGapColumn" Width="10" />
                <ColumnDefinition x:Name="SeriesChartsColumn" Width="*" />
                <ColumnDefinition x:Name="SeriesSecondGapColumn" Width="10" />
                <ColumnDefinition x:Name="SeriesResultsColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="SeriesParametersPanel" Style="{StaticResource PanelBorderStyle}" Padding="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Постоянные параметры" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Длина волны λ" />
                        <TextBox Grid.Column="1" Text="1,000" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Угол θ, °" />
                        <TextBox Grid.Column="1" Text="45,0" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Параметр N" />
                        <TextBox Grid.Column="1" Text="30" />
                    </Grid>

                    <TextBlock Grid.Row="4" Margin="0,14,0,0" FontWeight="SemiBold" Text="Диапазон толщины δ" />
                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Начало" />
                        <TextBox Grid.Column="1" Text="0,000" />
                        <TextBlock Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center" Text="Конец" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="0,100" />
                        <TextBlock Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Center" Text="Точек" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="21" />
                        <Slider Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" Minimum="5" Maximum="101" Value="21" TickFrequency="4" IsSnapToTickEnabled="True" />
                    </Grid>

                    <controls:PlateGeometryView Grid.Row="6" Margin="0,12,0,5" MinHeight="180" />
                    <StackPanel Grid.Row="7">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Толщина на схеме отображается условно." />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="21 расчёт  •  ориентировочно 18 с" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2" x:Name="SeriesChartsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.45*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="10">
                    <TabControl>
                        <TabItem Header="По толщине δ">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <controls:ScientificPlot Margin="0,0,0,6" PlotKind="Energy" />
                                <TextBlock Grid.Row="1" Style="{StaticResource CaptionStyle}" Text="R_scat и T_scat совпадают и уменьшаются вместе. Пунктирная T_scat наложена на сплошную R_scat." TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="По углу θ">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <controls:ScientificPlot Margin="0,0,0,6" PlotKind="AngleEnergy" />
                                <TextBlock Grid.Row="1" Style="{StaticResource CaptionStyle}" Text="Контрольная серия: δ=0,010, N=30. Углы ниже 10° исключены из масштаба из-за нормировки I_plate ∝ sin θ." TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Невязка ЗСЭ и различие потоков" />
                        <controls:ScientificPlot Grid.Row="1" Margin="0,7,0,5" PlotKind="EnergyDiagnostics" />
                        <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="Невязка ЗСЭ остаётся ниже 0,05%; различие R_scat/T_scat находится на уровне машинного округления." />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="4" x:Name="SeriesResultsPanel" Style="{StaticResource PanelBorderStyle}" Padding="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Выбранная точка: δ = 0,010" />
                    <Separator Grid.Row="1" Margin="0,8" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="R_scat, обратно" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Energy.ReflectedDisplay}" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="T_scat, вперёд" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Energy.ForwardDisplay}" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="A_J, пластина" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Energy.AbsorbedDisplay}" />
                    </Grid>
                    <Grid Grid.Row="5" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Невязка ЗСЭ" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="{Binding Energy.LocalBalanceErrorDisplay}" />
                    </Grid>
                    <Grid Grid.Row="6" Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" FontWeight="SemiBold" Text="Потоки сверху/снизу" />
                        <TextBlock Grid.Row="1" Margin="0,7,0,0" Text="Сверху / снизу" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{Binding Energy.SheetPairDisplay}" />
                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="Разность" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="0,000000% — совпадают" />
                    </Grid>

                    <DataGrid Grid.Row="7" Margin="0,14,0,8" AutoGenerateColumns="False" MinHeight="135">
                        <DataGrid.Items>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">Толщина δ 0...0,100  •  нарушений не найдено</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">Угол θ 10...90°  •  R_scat и T_scat совпадают</sys:String>
                        </DataGrid.Items>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Контроль серии" Binding="{Binding}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCommand}" Content="Экспортировать серию" />
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
