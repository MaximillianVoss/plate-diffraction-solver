<UserControl x:Class="Diffraction.WpfPrototype.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Справка" />
            <TextBlock Margin="0,4,0,14" Style="{StaticResource CaptionStyle}" Text="Определения входных параметров и правила чтения энергетических результатов." />

            <Border Style="{StaticResource PanelBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Параметры задачи" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="λ — длина волны в мкм; θ — угол относительно плоскости пластины (90° — нормальное падение); α₁ и β₁ — границы пластины в мкм; N — число коэффициентов; δ — толщина скин-слоя в мкм." />
                    <TextBlock Margin="0,8,0,0" Text="xL, xR, yDn и yUp задают только область построения поля и не должны изменять энергетический баланс пластины." />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="При δ > 0 ток J(τ) = Σ c_n P_n(τ) разлагается по полиномам Лежандра без веса. Для PEC (δ = 0): J(τ) = Σ c_n T_n(τ)/√(1−τ²), взвешенный базис Чебышёва. n = 0…N−1; τ — локальная координата на пластине от −1 до 1. В серии, включающей δ = 0, базис меняется; коэффициенты разных базисов напрямую не сопоставляются." />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PanelBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Энергетические показатели" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="R_scat и T_scat — потоки рассеянного поля назад и вперёд, A_J — джоулево поглощение в пластине. Эти три диагностические величины нельзя напрямую трактовать как обычные коэффициенты R, T и A." />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Графики показывают сечения C_back, C_forward, C_abs и C_ext в мкм. Таблицы серий показывают проценты от геометрического падающего потока I_plate; сумма сравнивается с независимой экстинкцией, а не со 100%." />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Проверяются обе невязки: локальная — относительно I_plate, оптической теоремы P_ext = P_scat + P_abs — относительно P_ext. Статус «В допуске» требует, чтобы каждая не превышала 2%." />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PanelBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Потоки сверху и снизу" />
                    <TextBlock Margin="0,10,0,0" Text="Сопоставляются значения на двух сторонах тонкой пластины, абсолютная и относительная разность. Результат считается согласованным, если различие не превышает установленный допуск." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
