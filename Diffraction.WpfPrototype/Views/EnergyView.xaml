<UserControl x:Class="Diffraction.WpfPrototype.Views.EnergyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Diffraction.WpfPrototype.Controls">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="R — отражение" />
                        <TextBlock Margin="0,2,0,0" FontSize="25" FontWeight="SemiBold" Text="0,628" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="62,8% от I" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="T — прохождение" />
                        <TextBlock Margin="0,2,0,0" FontSize="25" FontWeight="SemiBold" Text="0,251" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="25,1% от I" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="A — поглощение" />
                        <TextBlock Margin="0,2,0,0" FontSize="25" FontWeight="SemiBold" Text="0,121" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="12,1% от I" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Невязка ЗСЭ" />
                        <TextBlock Margin="0,2,0,0" FontSize="25" FontWeight="SemiBold" Text="0,3%" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="допуск 1,0%" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource SuccessBrush}" Text="&#xE73E;" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="В допуске" />
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionStyle}" Text="Баланс R + T + A = 1,000" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
        <Grid MinHeight="430">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="1.45*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="148" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Геометрия пластины" />
                    <controls:PlateGeometryView Grid.Row="1" Margin="0,5,0,0" />
                    <Grid Grid.Row="2" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="α₁ = −1,500" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="β₁ = −0,500" />
                    </Grid>
                    <TextBlock Grid.Row="3" Margin="0,3,0,6" Foreground="{StaticResource WarningBrush}" FontSize="10.5" Text="Толщина δ показана условно: 0,010000 мкм" />
                    <Grid Grid.Row="4" MinHeight="116">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Margin="0,0,0,3" FontSize="10.5" Text="Идеал" />
                            <controls:FieldMapView />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,3" FontSize="10.5" Text="Скин-слой" />
                            <controls:FieldMapView SkinEnabled="True" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="5" Margin="0,6,0,0" Style="{StaticResource CaptionStyle}" Text="Полное синхронное сравнение с общей шкалой доступно на вкладке «Карта поля»." TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Энергии в зависимости от толщины скин-слоя" />
                    <controls:ScientificPlot Grid.Row="1" Margin="0,8,0,8" MinHeight="280" PlotKind="Energy" />
                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="График показывает нормированные доли R, T и A. Для каждой точки контролируются баланс и знак прошедшей энергии." TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Сравнение потоков на границах" />
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FluxSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по таблице" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding FluxCategories}" SelectedItem="{Binding FluxCategory}" ToolTip="Фильтр категории" />
                        <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Command="{x:Static ApplicationCommands.Copy}" CommandTarget="{Binding ElementName=FluxGrid}" Content="&#xE8C8;" ToolTip="Копировать выделенное" />
                    </Grid>
                    <DataGrid Grid.Row="2" x:Name="FluxGrid" ItemsSource="{Binding FluxView}" AutoGenerateColumns="False" MinHeight="230">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Показатель" Binding="{Binding Metric}" Width="1.7*" />
                            <DataGridTextColumn Header="Сверху" Binding="{Binding Top, StringFormat=0.000}" Width="*" />
                            <DataGridTextColumn Header="Снизу" Binding="{Binding Bottom, StringFormat=0.000}" Width="*" />
                            <DataGridTextColumn Header="Разность" Binding="{Binding DifferencePercent, StringFormat={}{0:0.00}%}" Width="*" />
                            <DataGridTextColumn Header="Допуск" Binding="{Binding TolerancePercent, StringFormat={}{0:0.0}%}" Width="*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{x:Static ApplicationCommands.Copy}" Header="Копировать выбранные ячейки" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Margin="0,7,0,8" Style="{StaticResource CaptionStyle}" Text="Доступны сортировка, перестановка столбцов, поиск, фильтрация и копирование. Верхний и нижний потоки сопоставляются с учётом направления нормали." TextWrapping="Wrap" />
                    <Border Grid.Row="4" Padding="9" Background="#FFFAEB" BorderBrush="#FEC84B" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WarningBrush}" Text="&#xE7BA;" />
                            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="Проверить знак прошедшей энергии" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Padding="9,4" MinHeight="27" Style="{StaticResource SecondaryButtonStyle}" Content="Открыть диагностику" Click="OpenDiagnostics_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
