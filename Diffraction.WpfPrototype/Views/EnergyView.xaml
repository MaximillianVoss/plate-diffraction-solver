<UserControl x:Class="Diffraction.WpfPrototype.Views.EnergyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Diffraction.WpfPrototype.Controls">
    <Grid x:Name="EnergyRoot" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SummaryRow" Height="90" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="DesktopSummary">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="8" Style="{StaticResource PanelBorderStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:InfoLabel HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="R_scat — обратно"
                                        HelpText="Нормированный поток рассеянного поля вверх. Это не полный коэффициент отражения." />
                    <TextBlock Margin="0,2,0,0" FontSize="25" FontWeight="SemiBold" Text="{Binding Energy.ReflectedDisplay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Energy.ReflectedPercentDisplay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="8" Style="{StaticResource PanelBorderStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:InfoLabel HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="T_scat — вперёд"
                                        HelpText="Нормированный поток рассеянного поля вниз. Это не полная прошедшая энергия." />
                    <TextBlock Margin="0,2,0,0" FontSize="25" FontWeight="SemiBold" Text="{Binding Energy.ForwardDisplay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Energy.ForwardPercentDisplay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Padding="8" Style="{StaticResource PanelBorderStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:InfoLabel HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="A_J — поглощение"
                                        HelpText="Джоулево поглощение, вычисленное интегрированием по самой пластине." />
                    <TextBlock Margin="0,2,0,0" FontSize="25" FontWeight="SemiBold" Text="{Binding Energy.AbsorbedDisplay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Energy.AbsorbedPercentDisplay}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Padding="8" Style="{StaticResource PanelBorderStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:InfoLabel HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Локальная невязка ЗСЭ"
                                        HelpText="Относительная невязка локального энергетического равенства на пластине." />
                    <TextBlock Margin="0,2,0,0" FontSize="25" FontWeight="SemiBold" Text="{Binding Energy.LocalBalanceErrorDisplay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="допуск 2,0%" />
                </StackPanel>
            </Border>
            <Border Grid.Column="8" Padding="8" Background="{Binding Energy.BalanceBackground}" BorderBrush="{Binding Energy.BalanceBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{Binding Energy.BalanceForeground}" Text="&#xE73E;" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Energy.BalanceForeground}" Text="{Binding Energy.BalanceStatus}" />
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding Energy.LocalBalanceResidualDisplay}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0" x:Name="CompactSummary" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid Columns="2">
                    <Border Margin="0,0,3,3" Padding="7" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <controls:InfoLabel HorizontalAlignment="Center" FontSize="11.5" Text="R_scat — обратно" HelpText="Поток рассеянного поля вверх; не полный коэффициент отражения." />
                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{Binding Energy.ReflectedDisplay}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="3,0,0,3" Padding="7" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <controls:InfoLabel HorizontalAlignment="Center" FontSize="11.5" Text="T_scat — вперёд" HelpText="Поток рассеянного поля вниз; не полная прошедшая энергия." />
                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{Binding Energy.ForwardDisplay}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,3,3,0" Padding="7" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <controls:InfoLabel HorizontalAlignment="Center" FontSize="11.5" Text="A_J — поглощение" HelpText="Джоулево поглощение, интегрированное по пластине." />
                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{Binding Energy.AbsorbedDisplay}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="3,3,0,0" Padding="7" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <controls:InfoLabel HorizontalAlignment="Center" FontSize="11.5" Text="Невязка ЗСЭ" HelpText="Относительная невязка локального энергетического равенства." />
                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="{Binding Energy.LocalBalanceErrorDisplay}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Grid.Row="1" Margin="0,6,0,0" Padding="8" Background="{Binding Energy.BalanceBackground}" BorderBrush="{Binding Energy.BalanceBorder}" BorderThickness="1" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="{Binding Energy.BalanceForeground}" Text="&#xE73E;" />
                        <TextBlock Margin="7,0,0,0" Foreground="{Binding Energy.BalanceForeground}" FontWeight="SemiBold" Text="{Binding Energy.CompactBalanceDisplay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      x:Name="ResultsScroll"
                      Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
        <Grid x:Name="ResultsGrid" MinHeight="430">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GeometryColumn" Width="240" />
                <ColumnDefinition x:Name="FirstGapColumn" Width="9" />
                <ColumnDefinition x:Name="EnergyColumn" Width="1.05*" />
                <ColumnDefinition x:Name="SecondGapColumn" Width="9" />
                <ColumnDefinition x:Name="FluxColumn" Width="1.45*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FirstGapRow" Height="0" />
                <RowDefinition x:Name="EnergyMobileRow" Height="0" />
                <RowDefinition x:Name="SecondGapRow" Height="0" />
                <RowDefinition x:Name="FluxMobileRow" Height="0" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" x:Name="GeometryPanel" Style="{StaticResource PanelBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="148" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Геометрия пластины" />
                    <controls:PlateGeometryView Grid.Row="1" Margin="0,5,0,0" />
                    <Grid Grid.Row="2" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionStyle}">
                            <Run Text="α₁ = " /><Run Text="{Binding Parameters.PlateStart, StringFormat={}{0:0.000}}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}">
                            <Run Text="β₁ = " /><Run Text="{Binding Parameters.PlateEnd, StringFormat={}{0:0.000}}" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="3" Margin="0,3,0,6" Foreground="{StaticResource WarningBrush}" FontSize="10.5">
                        <Run Text="Толщина δ показана условно: " />
                        <Run Text="{Binding Energy.SkinDepthDisplay, Mode=OneWay}" />
                        <Run Text=" мкм" />
                    </TextBlock>
                    <Grid Grid.Row="4" MinHeight="116">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Margin="0,0,0,3" FontSize="10.5" Text="Идеал" />
                            <controls:FieldMapView Data="{Binding IdealFieldMap}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,3" FontSize="10.5" Text="Скин-слой" />
                            <controls:FieldMapView Data="{Binding SkinFieldMap}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="5" Margin="0,6,0,0" Style="{StaticResource CaptionStyle}" Text="Полное синхронное сравнение с общей шкалой доступно на вкладке «Карта поля»." TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2" x:Name="EnergyPanel" Style="{StaticResource PanelBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Энергетика текущего расчёта" />
                    <controls:ScientificPlot Grid.Row="1" Margin="0,8,0,8" MinHeight="280" Data="{Binding CurrentEnergyPlot}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="Точки рассчитаны независимо для текущей толщины δ и нормированы на падающий поток через пластину." TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="4" x:Name="FluxPanel" Style="{StaticResource PanelBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Сравнение контрольных величин" />
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FluxSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по таблице" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding FluxCategories}" SelectedItem="{Binding FluxCategory}" ToolTip="Фильтр категории" />
                        <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Command="{x:Static ApplicationCommands.Copy}" CommandTarget="{Binding ElementName=FluxGrid}" Content="&#xE8C8;" ToolTip="Копировать выделенное" />
                    </Grid>
                    <DataGrid Grid.Row="2" x:Name="FluxGrid" ItemsSource="{Binding FluxView}" AutoGenerateColumns="False" MinHeight="230">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Показатель" Binding="{Binding Metric}" MinWidth="100" Width="1.55*" />
                            <DataGridTextColumn Header="Пара 1" Binding="{Binding Top, StringFormat=0.000000}" MinWidth="52" Width="0.9*" />
                            <DataGridTextColumn Header="Пара 2" Binding="{Binding Bottom, StringFormat=0.000000}" MinWidth="52" Width="0.9*" />
                            <DataGridTextColumn Header="Δ, %" Binding="{Binding DifferencePercent, StringFormat={}{0:0.######}%}" MinWidth="52" Width="0.75*" />
                            <DataGridTextColumn Header="Допуск" Binding="{Binding TolerancePercent, StringFormat={}{0:0.######}%}" MinWidth="55" Width="0.8*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" ElementStyle="{StaticResource StatusCellTextStyle}" MinWidth="65" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{x:Static ApplicationCommands.Copy}" Header="Копировать выбранные ячейки" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Margin="0,7,0,8" Style="{StaticResource CaptionStyle}" Text="Порядок сравниваемой пары указан в названии строки. R_scat/T_scat и потоки у листа проверяются отдельно от локального баланса A_flux/A_J." TextWrapping="Wrap" />
                    <Border Grid.Row="4" Padding="9" Background="{Binding Energy.FarFieldBackground}" BorderBrush="{Binding Energy.FarFieldBorder}" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="{Binding Energy.FarFieldForeground}" Text="&#xE73E;" />
                            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Foreground="{Binding Energy.FarFieldForeground}" FontWeight="SemiBold" Text="{Binding Energy.FarFieldStatus}" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Padding="9,4" MinHeight="27" Style="{StaticResource SecondaryButtonStyle}" Content="Открыть диагностику" Click="OpenDiagnostics_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
