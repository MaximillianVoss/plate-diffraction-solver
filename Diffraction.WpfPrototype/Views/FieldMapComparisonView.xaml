<UserControl x:Class="Diffraction.WpfPrototype.Views.FieldMapComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Diffraction.WpfPrototype.Controls">
    <ScrollViewer x:Name="ComparisonScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="ComparisonGrid" Margin="12" MinHeight="620">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="MapsMainRow" Height="2.2*" />
            <RowDefinition x:Name="DifferenceRow" Height="1*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="HeaderGrid" Margin="0,0,0,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="CompactHeaderControlRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Синхронное сравнение карт поля" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="Обе карты используют одинаковую цветовую шкалу и область координат." />
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="LinkCursorsCheckBox" IsChecked="True" VerticalAlignment="Center" Content="Связать курсоры" />
        </Grid>

        <Grid Grid.Row="1" x:Name="MapsGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="MapsGapRow" Height="0" />
                <RowDefinition x:Name="SkinMapRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IdealMapColumn" Width="*" />
                <ColumnDefinition x:Name="MapsGapColumn" Width="10" />
                <ColumnDefinition x:Name="SkinMapColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="IdealPanel" Style="{StaticResource PanelBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Идеальный проводник, δ = 0" />
                    <controls:FieldMapView Grid.Row="1" x:Name="IdealMap" Margin="0,7,0,7" Data="{Binding IdealFieldMap}" CursorChanged="IdealMap_CursorChanged" />
                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="Опорное поле для идеально проводящей тонкой пластины." />
                </Grid>
            </Border>
            <Border Grid.Column="2" x:Name="SkinPanel" Style="{StaticResource PanelBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Со скин-слоем, δ = " /><Run Text="{Binding Parameters.SkinDepthMicrometers, StringFormat={}{0:0.000000}}" />
                    </TextBlock>
                    <controls:FieldMapView Grid.Row="1" x:Name="SkinMap" Margin="0,7,0,7" Data="{Binding SkinFieldMap}" CursorChanged="SkinMap_CursorChanged" />
                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="Поле с импедансным граничным условием и учётом скин-слоя." />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" x:Name="DifferencePanel" Margin="0,10,0,0" Style="{StaticResource PanelBorderStyle}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Профиль разности решений" />
                <controls:ScientificPlot Grid.Row="1" Margin="0,6,0,5" MinHeight="120" Data="{Binding SkinDifferencePlot}" />
                <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="График показывает |u_skin − u_ideal| на выбранном сечении. Общая шкала карт позволяет сравнивать амплитуды напрямую, а связанный курсор — проверять одну координату в обеих моделях." />
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
