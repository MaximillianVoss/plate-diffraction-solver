<UserControl x:Class="Diffraction.WpfPrototype.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SettingsContent" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Настройки" />
            <TextBlock Margin="0,4,0,14" Style="{StaticResource CaptionStyle}" Text="Параметры интерфейса, допусков и вычислительного backend." />

            <Border Style="{StaticResource PanelBorderStyle}" Padding="16">
                <Grid x:Name="GeneralSettingsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="GeneralLabelColumn" Width="*" /><ColumnDefinition x:Name="GeneralControlColumn" Width="220" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition x:Name="GeneralControlRow1" Height="0" /><RowDefinition x:Name="GeneralLabelRow2" Height="0" /><RowDefinition x:Name="GeneralControlRow2" Height="0" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="BackendLabel" FontWeight="SemiBold" Text="Backend по умолчанию" />
                    <ComboBox x:Name="BackendControl" Grid.Column="1" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" />
                    <TextBlock x:Name="MapLabel" Grid.Row="1" Margin="0,16,0,0" FontWeight="SemiBold" Text="Автоматически строить карту поля" />
                    <CheckBox x:Name="MapControl" Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" VerticalAlignment="Center" Content="После основного результата" />
                    <TextBlock x:Name="HistoryLabel" Grid.Row="2" Margin="0,16,0,0" FontWeight="SemiBold" Text="Хранить историю расчётов" />
                    <CheckBox x:Name="HistoryControl" Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" IsChecked="True" VerticalAlignment="Center" Content="Включено" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PanelBorderStyle}" Padding="16">
                <Grid x:Name="ToleranceSettingsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ToleranceLabelColumn" Width="*" /><ColumnDefinition x:Name="ToleranceControlColumn" Width="140" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ToleranceControlRow1" Height="0" /><RowDefinition x:Name="ToleranceLabelRow2" Height="0" /><RowDefinition x:Name="ToleranceControlRow2" Height="0" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="EnergyToleranceLabel" FontWeight="SemiBold" Text="Допуск невязки ЗСЭ, %" />
                    <TextBox x:Name="EnergyToleranceControl" Grid.Column="1" Text="1,00" />
                    <TextBlock x:Name="FluxToleranceLabel" Grid.Row="1" Margin="0,12,0,0" FontWeight="SemiBold" Text="Допуск различия потоков, %" />
                    <TextBox x:Name="FluxToleranceControl" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Text="1,00" />
                    <TextBlock x:Name="NegativeEnergyLabel" Grid.Row="2" Margin="0,12,0,0" FontWeight="SemiBold" Text="Предупреждать об отрицательной энергии" />
                    <CheckBox x:Name="NegativeEnergyControl" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" IsChecked="True" VerticalAlignment="Center" Content="Да" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
