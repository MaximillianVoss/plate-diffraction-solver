<UserControl x:Class="Diffraction.WpfPrototype.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Настройки" />
            <TextBlock Margin="0,4,0,14" Style="{StaticResource CaptionStyle}" Text="Параметры интерфейса, допусков и вычислительного backend." />

            <Border Style="{StaticResource PanelBorderStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Backend по умолчанию" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" />
                    <TextBlock Grid.Row="1" Margin="0,16,0,0" FontWeight="SemiBold" Text="Автоматически строить карту поля" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" VerticalAlignment="Center" Content="После основного результата" />
                    <TextBlock Grid.Row="2" Margin="0,16,0,0" FontWeight="SemiBold" Text="Хранить историю расчётов" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" IsChecked="True" VerticalAlignment="Center" Content="Включено" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PanelBorderStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Допуск невязки ЗСЭ, %" />
                    <TextBox Grid.Column="1" Text="1,00" />
                    <TextBlock Grid.Row="1" Margin="0,12,0,0" FontWeight="SemiBold" Text="Допуск различия потоков, %" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Text="1,00" />
                    <TextBlock Grid.Row="2" Margin="0,12,0,0" FontWeight="SemiBold" Text="Предупреждать об отрицательной энергии" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" IsChecked="True" VerticalAlignment="Center" Content="Да" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
