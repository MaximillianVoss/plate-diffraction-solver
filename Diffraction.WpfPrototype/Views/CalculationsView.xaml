<UserControl x:Class="Diffraction.WpfPrototype.Views.CalculationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Diffraction.WpfPrototype.Controls"
             xmlns:views="clr-namespace:Diffraction.WpfPrototype.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="DesktopHeader" Margin="2,0,2,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Расчёт #024 — тонкая пластина" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="λ 1 мкм  •  θ 45°  •  α₁ −1,500  •  β₁ −0,500  •  N 30" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="Режим:" />
                <RadioButton GroupName="Mode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsSingleMode, Mode=TwoWay}" Content="Один расчёт" />
                <RadioButton GroupName="Mode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsSeriesMode, Mode=TwoWay}" Content="Серия" />
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="Решатель:" />
                <ComboBox Width="98" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" ToolTip="Выбор вычислительного backend" />
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CompareCommand}" Content="Сравнить" />
                <Button Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCommand}" Content="Экспорт" />
                <Button Margin="0,0,6,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE768;" />
                        <TextBlock Foreground="White" Text="Рассчитать" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" Content="Отмена" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" x:Name="CompactHeader" Margin="1,0,1,8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Расчёт #024 — тонкая пластина" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionStyle}" Text="λ 1 мкм  •  θ 45°  •  N 30" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="Режим:" />
                <RadioButton GroupName="CompactMode" Style="{StaticResource SegmentRadioStyle}" Padding="10,6" MinWidth="68" IsChecked="{Binding IsSingleMode, Mode=TwoWay}" Content="Один" />
                <RadioButton GroupName="CompactMode" Style="{StaticResource SegmentRadioStyle}" Padding="10,6" MinWidth="68" IsChecked="{Binding IsSeriesMode, Mode=TwoWay}" Content="Серия" />
                <TextBlock Margin="12,0,7,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="Решатель:" />
                <ComboBox Width="94" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" />
            </WrapPanel>
            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                <Button Margin="0,0,6,6" Style="{StaticResource PrimaryButtonStyle}" Padding="11,7" Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE768;" />
                        <TextBlock Foreground="White" Text="Рассчитать" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,6,6" Style="{StaticResource SecondaryButtonStyle}" Padding="11,7" Command="{Binding CompareCommand}" Content="Сравнить" />
                <Button Margin="0,0,6,6" Style="{StaticResource SecondaryButtonStyle}" Padding="11,7" Command="{Binding ExportCommand}" Content="Экспорт" />
                <Button Margin="0,0,0,6" Style="{StaticResource DangerButtonStyle}" Padding="11,7" Command="{Binding CancelCommand}" Content="Отмена" />
            </WrapPanel>
        </Grid>

        <Expander Grid.Row="1"
                  x:Name="ParametersExpander"
                  Margin="0,0,0,9"
                  IsExpanded="True"
                  Background="White"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  Header="Параметры эксперимента">
            <Grid>
            <Grid x:Name="DesktopParameterGrid" Margin="12,8,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="λ, мкм" />
                    <TextBox Margin="0,4,0,0" Text="1,000" ToolTip="Нормированная длина волны" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="θ, °" />
                    <TextBox Margin="0,4,0,0" Text="45,0" ToolTip="Угол падения" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="α₁" />
                    <TextBox Margin="0,4,0,0" Text="-1,500" ToolTip="Левая граница пластины" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="β₁" />
                    <TextBox Margin="0,4,0,0" Text="-0,500" ToolTip="Правая граница пластины" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="N" />
                    <TextBox Margin="0,4,0,0" Text="30" ToolTip="Параметр усечения" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="δ, мкм" />
                    <TextBox Margin="0,4,0,0" Text="0,010000" ToolTip="Толщина скин-слоя" />
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="xL" />
                    <TextBox Margin="0,4,0,0" Text="-2,00" />
                </StackPanel>
                <StackPanel Grid.Column="7" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="xR" />
                    <TextBox Margin="0,4,0,0" Text="2,00" />
                </StackPanel>
                <StackPanel Grid.Column="8" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="yDn" />
                    <TextBox Margin="0,4,0,0" Text="-3,00" />
                </StackPanel>
                <StackPanel Grid.Column="9" Margin="0,0,7,0">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="yUp" />
                    <TextBox Margin="0,4,0,0" Text="3,00" />
                </StackPanel>
                <StackPanel Grid.Column="10" Margin="12,17,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SuccessBrush}" Text="&#xE73E;" />
                    <TextBlock Margin="7,0,0,0" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="Параметры корректны" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="CompactParameterScroll"
                          Visibility="Collapsed"
                          MaxHeight="230"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <UniformGrid Columns="2" Margin="9,7,9,9">
                    <StackPanel Margin="3,3,5,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="λ, мкм" />
                        <TextBox Margin="0,4,0,0" Text="1,000" />
                    </StackPanel>
                    <StackPanel Margin="5,3,3,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="θ, °" />
                        <TextBox Margin="0,4,0,0" Text="45,0" />
                    </StackPanel>
                    <StackPanel Margin="3,3,5,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="α₁" />
                        <TextBox Margin="0,4,0,0" Text="-1,500" />
                    </StackPanel>
                    <StackPanel Margin="5,3,3,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="β₁" />
                        <TextBox Margin="0,4,0,0" Text="-0,500" />
                    </StackPanel>
                    <StackPanel Margin="3,3,5,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="N" />
                        <TextBox Margin="0,4,0,0" Text="30" />
                    </StackPanel>
                    <StackPanel Margin="5,3,3,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="δ, мкм" />
                        <TextBox Margin="0,4,0,0" Text="0,010000" />
                    </StackPanel>
                    <StackPanel Margin="3,3,5,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="xL" />
                        <TextBox Margin="0,4,0,0" Text="-2,00" />
                    </StackPanel>
                    <StackPanel Margin="5,3,3,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="xR" />
                        <TextBox Margin="0,4,0,0" Text="2,00" />
                    </StackPanel>
                    <StackPanel Margin="3,3,5,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="yDn" />
                        <TextBox Margin="0,4,0,0" Text="-3,00" />
                    </StackPanel>
                    <StackPanel Margin="5,3,3,5">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="yUp" />
                        <TextBox Margin="0,4,0,0" Text="3,00" />
                    </StackPanel>
                </UniformGrid>
            </ScrollViewer>
            </Grid>
        </Expander>

        <ComboBox Grid.Row="2"
                  x:Name="CompactResultSelector"
                  Visibility="Collapsed"
                  Margin="0,0,0,7"
                  SelectedIndex="{Binding ElementName=ResultTabs, Path=SelectedIndex, Mode=TwoWay}">
            <ComboBoxItem Content="Энергия" />
            <ComboBoxItem Content="Сечение поля" />
            <ComboBoxItem Content="Карта поля" />
            <ComboBoxItem Content="Галеркин / коллокация" />
            <ComboBoxItem Content="Графики экспорта" />
            <ComboBoxItem Content="Коэффициенты" />
            <ComboBoxItem Content="Диагностика" />
        </ComboBox>

        <TabControl Grid.Row="3" x:Name="ResultTabs" SelectedIndex="0">
            <TabItem Header="Энергия">
                <views:EnergyView />
            </TabItem>
            <TabItem Header="Сечение поля">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Вещественная часть поля на контрольном сечении" />
                    <controls:ScientificPlot Grid.Row="1" Margin="0,10,0,8" MinHeight="320" PlotKind="Slice" />
                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="Сечение показывает полное поле u(x, λ/10) для идеальной пластины и модели со скин-слоем. Наведите курсор на график для чтения координат." />
                </Grid>
            </TabItem>
            <TabItem Header="Карта поля">
                <views:FieldMapComparisonView />
            </TabItem>
            <TabItem Header="Галеркин/коллокация">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Сравнение Галеркина и коллокации" />
                    <controls:ScientificPlot Grid.Row="1" Margin="0,10,0,8" MinHeight="220" PlotKind="Method" />
                    <controls:ScientificPlot Grid.Row="2" Margin="0,0,0,8" MinHeight="130" PlotKind="Difference" />
                    <TextBlock Grid.Row="3" Style="{StaticResource CaptionStyle}" Text="Верхний график сопоставляет решения двух методов, нижний показывает модуль их разности. Для проверки сходимости следует анализировать максимум разности вместе с невязкой граничного условия." />
                </Grid>
            </TabItem>
            <TabItem Header="Графики экспорта">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Подготовленные графики" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCommand}" Content="Экспортировать выбранное" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ScientificPlot Grid.Column="0" PlotKind="Slice" />
                        <controls:ScientificPlot Grid.Column="2" PlotKind="Method" />
                    </Grid>
                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionStyle}" Text="Экспорт должен сохранять исходные точки, подписи осей, легенду и снимок параметров расчёта. В полном варианте здесь будут CSV, PNG, SVG и единый отчёт." />
                </Grid>
            </TabItem>
            <TabItem Header="Коэффициенты">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Width="290" HorizontalAlignment="Left" Text="{Binding CoefficientSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по номеру или значению коэффициента" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Static ApplicationCommands.Copy}" CommandTarget="{Binding ElementName=CoefficientGrid}" Content="Копировать выделенное" />
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="CoefficientGrid" ItemsSource="{Binding CoefficientsView}" AutoGenerateColumns="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="n" Binding="{Binding Index}" Width="70" />
                            <DataGridTextColumn Header="Коллокация Re" Binding="{Binding CollocationRe, StringFormat=G8}" MinWidth="120" Width="*" />
                            <DataGridTextColumn Header="Коллокация Im" Binding="{Binding CollocationIm, StringFormat=G8}" MinWidth="120" Width="*" />
                            <DataGridTextColumn Header="Галеркин Re" Binding="{Binding GalerkinRe, StringFormat=G8}" MinWidth="120" Width="*" />
                            <DataGridTextColumn Header="Галеркин Im" Binding="{Binding GalerkinIm, StringFormat=G8}" MinWidth="120" Width="*" />
                            <DataGridTextColumn Header="|Δ|" Binding="{Binding Delta, StringFormat=0.000E+00}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" Text="Таблица поддерживает сортировку столбцов, изменение их ширины, поиск, множественное выделение и копирование с заголовками." />
                </Grid>
            </TabItem>
            <TabItem Header="Диагностика">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Структурированная диагностика расчёта" />
                    <DataGrid Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Раздел" Binding="{Binding Group}" MinWidth="140" Width="1.1*" />
                            <DataGridTextColumn Header="Проверка" Binding="{Binding Check}" MinWidth="180" Width="1.5*" />
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" MinWidth="90" Width="*" />
                            <DataGridTextColumn Header="Допуск" Binding="{Binding Tolerance}" MinWidth="90" Width="*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" ElementStyle="{StaticResource StatusCellTextStyle}" MinWidth="90" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,0,0,5" FontWeight="SemiBold" Text="Полный текстовый отчёт" />
                    <TextBox Grid.Row="3"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             Text="ЗСЭ: R + T + A = 1,000; локальная невязка 0,30% (допуск 1,00%).&#x0a;Потоки тока на верхней и нижней сторонах: 0,629 / 0,625; относительная разность 0,64%.&#x0a;Граничное условие и уравнение Гельмгольца выполнены в установленном допуске.&#x0a;Примечание: направления потоков и знак прошедшей энергии должны отображаться явно." />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
