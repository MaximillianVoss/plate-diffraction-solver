<Window x:Class="Diffraction.WpfPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Diffraction.WpfPrototype.Views"
        mc:Ignorable="d"
        Language="ru-RU"
        Title="Решатель дифракции — одна пластина"
        Icon="Resources/AppIcon.ico"
        Width="1440"
        Height="900"
        MinWidth="360"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Validation.Error="ParameterValidation_Error"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border x:Name="ErrorBanner"
                Padding="12,10"
                Background="#FEF3F2"
                BorderBrush="#FDA29B"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,2,10,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#B42318" Text="&#xEA39;" />
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Foreground="#B42318" Text="{Binding ErrorTitle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorMessageText" Margin="0,3,0,0" Foreground="#912018" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Margin="10,0,0,0" Padding="0" Width="32" Height="32"
                        VerticalAlignment="Top" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DismissErrorCommand}" ToolTip="Закрыть сообщение"
                        AutomationProperties.Name="Закрыть сообщение об ошибке">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="ShellGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MobileHeaderRow" Height="0" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="MobileNavigationRow" Height="0" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    x:Name="MobileHeader"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="6,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MobileHistoryButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,6"
                            MinHeight="34"
                            Click="MobileHistoryButton_Click"
                            ToolTip="История расчётов">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" />
                            <TextBlock Margin="6,0,0,0" Text="История" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Решатель дифракции"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding NewRunCommand}"
                            Content="&#xE710;"
                            ToolTip="Новый расчёт" />

                    <Popup x:Name="MobileHistoryPopup"
                           PlacementTarget="{Binding ElementName=MobileHistoryButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border x:Name="MobileHistoryCard"
                                Width="330"
                                Height="420"
                                Margin="0,4,0,0"
                                Padding="10"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="История расчётов" />
                                <TextBox Grid.Row="1"
                                         Margin="0,9,0,8"
                                         Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Поиск по истории" />
                                <ListBox Grid.Row="2"
                                         ItemsSource="{Binding RunsView}"
                                         SelectedItem="{Binding SelectedRun}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="8,7" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="Открыть результаты расчёта" />
                                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HistoryItem_Click" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="{Binding HistoryTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="{Binding SkinDepth}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Margin="0,4,8,0" Style="{StaticResource CaptionStyle}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding FullParameterSummary}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" HorizontalAlignment="Right" Style="{StaticResource RunStatusTextStyle}" Text="{Binding Status}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="3" Margin="0,7,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding Runs.Count, StringFormat={}{0} записей}" />
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="78" />
                <ColumnDefinition x:Name="HistoryColumn" Width="260" />
                <ColumnDefinition x:Name="ContentColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="DesktopNavigation" Background="{StaticResource NavBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <RadioButton Grid.Row="0"
                                 GroupName="Navigation"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Calculations, Mode=OneWay}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Calculations"
                                 ToolTip="Расчёты">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE9D2;" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,5,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" FontSize="11" Text="Расчёты" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Row="1"
                                 GroupName="Navigation"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Series, Mode=OneWay}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Series"
                                 ToolTip="Серии расчётов">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE81E;" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,5,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" FontSize="11" Text="Серии" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Row="2"
                                 GroupName="Navigation"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Export, Mode=OneWay}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Export"
                                 ToolTip="Экспорт результатов">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xEDE1;" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,5,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" FontSize="11" Text="Экспорт" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Row="3"
                                 GroupName="Navigation"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings"
                                 ToolTip="Настройки">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE713;" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,5,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" FontSize="11" Text="Настройки" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Row="5"
                                 GroupName="Navigation"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Help, Mode=OneWay}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Help"
                                 ToolTip="Справка">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE897;" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,5,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" FontSize="11" Text="Справка" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Row="6"
                                 GroupName="Navigation"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=About, Mode=OneWay}"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="About"
                                 ToolTip="О программе">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE946;" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,5,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" FontSize="10.5" Text="О программе" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <Border Grid.Column="1" x:Name="HistoryPanel" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,13,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="История расчётов" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="9,6"
                                MinHeight="32"
                                Command="{Binding NewRunCommand}"
                                ToolTip="Создать новый расчёт">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE710;" />
                                <TextBlock Foreground="White" Text="Новый" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,0,12,10">
                        <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по истории расчётов" />
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Foreground="#98A2B3" IsHitTestVisible="False" Text="Поиск по истории...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistorySearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding RunsView}"
                             SelectedItem="{Binding SelectedRun}"
                             BorderThickness="0"
                             Background="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderBrush" Value="#E7EBF0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="ToolTip" Value="Открыть результаты расчёта" />
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HistoryItem_Click" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F8FF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EAF2FF" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="13,11">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="{Binding HistoryTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,8,0" Style="{StaticResource CaptionStyle}" Text="{Binding SkinDepth}" />
                                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,8,0" Style="{StaticResource CaptionStyle}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding FullParameterSummary}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" HorizontalAlignment="Right" Style="{StaticResource RunStatusTextStyle}" Text="{Binding Status}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Margin="14,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding Runs.Count, StringFormat={}{0} записей}" />
                </Grid>
            </Border>

            <Grid Grid.Column="2" x:Name="ContentHost" Margin="10">
                <views:CalculationsView Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Calculations}" />
                <views:SeriesView Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Series}" />
                <views:ExportView Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Export}" />
                <views:SettingsView Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Settings}" />
                <views:HelpView Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Help}" />
                <views:AboutView Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=About}" />
            </Grid>
        </Grid>

            <Border Grid.Row="2"
                    x:Name="MobileNavigation"
                    Visibility="Collapsed"
                    Background="{StaticResource NavBrush}"
                    BorderBrush="#344454"
                    BorderThickness="0,1,0,0">
                <UniformGrid Columns="6">
                    <RadioButton GroupName="MobileNavigation"
                                 Style="{StaticResource MobileNavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Calculations"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Calculations, Mode=OneWay}"
                                 ToolTip="Расчёты">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE9D2;" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="Расчёты" TextWrapping="NoWrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MobileNavigation"
                                 Style="{StaticResource MobileNavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Series"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Series, Mode=OneWay}"
                                 ToolTip="Серии">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE81E;" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="Серии" TextWrapping="NoWrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MobileNavigation"
                                 Style="{StaticResource MobileNavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Export"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Export, Mode=OneWay}"
                                 ToolTip="Экспорт">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xEDE1;" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="Экспорт" TextWrapping="NoWrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MobileNavigation"
                                 Style="{StaticResource MobileNavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                 ToolTip="Настройки">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE713;" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="Настр." TextWrapping="NoWrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MobileNavigation"
                                 Style="{StaticResource MobileNavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Help"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=Help, Mode=OneWay}"
                                 ToolTip="Справка">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE897;" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="Справка" TextWrapping="NoWrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MobileNavigation"
                                 Style="{StaticResource MobileNavRadioStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="About"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource SectionSelectionConverter}, ConverterParameter=About, Mode=OneWay}"
                                 ToolTip="О программе">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="&#xE946;" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Text="О прогр." TextWrapping="NoWrap" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>
        </Grid>

        <Expander Grid.Row="2"
                  x:Name="JournalExpander"
                  ExpandDirection="Up"
                  Style="{StaticResource JournalExpanderStyle}">
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}" Text="&#xE9D9;" />
                        <TextBlock Margin="7,0,0,0" FontWeight="SemiBold" Text="Журнал расчёта" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="JournalHint" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="раскрыть" />
                </Grid>
            </Expander.Header>
            <Grid Height="165" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="12,8,12,4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" MinHeight="28" Command="{Binding ClearJournalCommand}" Content="Очистить" />
                </StackPanel>
                <ListBox Grid.Row="1"
                         Margin="12,0,12,10"
                         Padding="8"
                         ItemsSource="{Binding JournalEntries}"
                         FontFamily="Consolas"
                         FontSize="11.5"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Background="#FCFDFE" />
            </Grid>
        </Expander>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusIndicatorColor}" />
                    <TextBlock x:Name="StatusTextBlock" Margin="8,0,0,0" FontWeight="SemiBold" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="StatusDetailText" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding StatusDetail}" TextWrapping="NoWrap" />
                </StackPanel>
                <ProgressBar Grid.Column="1"
                             Height="5"
                             Margin="24,0"
                             VerticalAlignment="Center"
                             Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Grid.Column="2" x:Name="BuildCaption" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Одна пластина  •  реальные вычисления Diffraction.Core" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
